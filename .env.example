# Backend API taban adresi.
# Simülatörde: http://localhost:8000
# Fiziksel cihazda (Expo Go, aynı Wi-Fi): http://<Mac LAN IP>:8000
# Preview/production: Railway HTTPS servis adresi
#   Mac IP'ni bulmak için: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth — publishable key client içinde kullanılabilir; service_role ASLA.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
