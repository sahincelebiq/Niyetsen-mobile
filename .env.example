# Backend API taban adresi.
# Simülatörde: http://localhost:8000
# Android emülatör: http://10.0.2.2:8000 (api.ts otomatik fallback)
# Fiziksel cihazda (development build, aynı Wi-Fi): http://<Mac LAN IP>:8000
# Preview/production: Railway HTTPS servis adresi
#   Mac IP'ni bulmak için: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (yalnızca publishable/anon — service_role ASLA buraya yazılmaz)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Auth deep link (Supabase Redirect URLs ile birebir)
# Expo Go: exp://…/--/auth/callback
# Kapalı test / EAS: niyetsen://auth/callback
# Şifre sıfırlama yedek yolu: niyetsen://sifre-sifirla

# PostHog (ücretsiz katman yeter) — boşsa analitik sessizce kapalı kalır
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat — önizleme sürümlerinde satın alma çalışmaz; EAS/dev build gerekir.
#
# Bunlar PUBLIC SDK anahtarıdır (uygulama ikilisine gömülmek için tasarlanmış,
# gizli değil). Android anahtarı eas.json'da açıkça duruyor. iOS anahtarı EAS
# ortam değişkeni olarak tanımlanır (eas.json'daki `environment` alanı seçer):
#   eas env:create --environment production \
#     --name EXPO_PUBLIC_REVENUECAT_IOS_API_KEY --value appl_XXXX --visibility plaintext
#
# UYARI: `$DEGISKEN` sözdizimi eas.json `env` bloğunda ÇÖZÜLMEZ — literal
# string olarak gömülür. Anahtarı ya doğrudan yaz ya EAS ortam değişkeni yap.
# purchases.ts geçersiz anahtarı (appl_/goog_/test_ öneki yoksa) yok sayar.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
# Entitlement ve paket kimlikleri (RevenueCat dashboard lookup_key ile eşleşmeli).
# Offering paketleri $rc_monthly / $rc_annual. Play SKU niyetsen_monthly:monthly
# paket kimliği DEĞİLDİR — buraya SKU yazılırsa fiyat okunamayabilir.
EXPO_PUBLIC_RC_ENTITLEMENT_ID=premium
EXPO_PUBLIC_RC_MONTHLY_PACKAGE=$rc_monthly
EXPO_PUBLIC_RC_YEARLY_PACKAGE=$rc_annual

# Sentry (opsiyonel) — EAS production build'de etkinleştir
EXPO_PUBLIC_SENTRY_DSN=

# Google ile giriş (yalnız WEB OAuth client ID — Android client değil).
# Boş bırakılabilir; sağlayıcı kapalıysa uygulama e-posta yolunu gösterir.
# Client secret / service_role / SMTP şifresi BURAYA YAZILMAZ.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
