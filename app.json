{
  "expo": {
    "name": "Niyetsen",
    "slug": "niyetsen",
    "owner": "sahincelebiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "niyetsen",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.niyetsen.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.niyetsen.app",
      "adaptiveIcon": {
        "backgroundColor": "#DA9B7C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Niyetsen, görev kanıtını yalnız uygulama içinden çekebilmen için kameraya erişir.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Niyetsen, seçtiğin İrade ve Disiplin görevlerini takvimine ekleyebilmek için izin ister.",
          "remindersPermission": "Niyetsen, seçtiğin görevler için takvim hatırlatıcıları oluşturabilmek için izin ister."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0236509-e919-49db-9e8a-c68addacd195"
      }
    }
  }
}